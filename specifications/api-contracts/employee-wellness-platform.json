{
  "paths": {
    "/login": {
      "post": {
        "summary": "User login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/password-recovery": {
      "post": {
        "summary": "Password recovery",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" }
                },
                "required": ["email"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Recovery email sent" },
          "404": { "description": "Email not found" }
        }
      }
    },
    "/dashboard/metrics": {
      "get": {
        "summary": "Retrieve dashboard metrics",
        "responses": {
          "200": { "description": "Metrics retrieved" },
          "204": { "description": "No Content" }
        }
      }
    }
  }
}